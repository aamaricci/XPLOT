def expression(spec):
    if re.fullmatch(r'[1-9]\d*', spec):
        index = int(spec) - 1
        return lambda row: row[index]
    spec = spec.replace('^', '**')
    translated = re.sub(r'\$(\d+)', lambda m: f'col({int(m[1])})', spec)
    try:
        tree = ast.parse(translated, mode='eval')
    except SyntaxError as exc:
        raise PlotError(f'invalid column expression {spec!r}') from exc
    allowed = (ast.Expression, ast.BinOp, ast.UnaryOp, ast.Call, ast.Name,
               ast.Load, ast.Constant, ast.Add, ast.Sub, ast.Mult, ast.Div,
               ast.Pow, ast.Mod, ast.UAdd, ast.USub, ast.FloorDiv)
    for node in ast.walk(tree):
        if not isinstance(node, allowed):
            raise PlotError(f'unsupported operation in {spec!r}')
        if isinstance(node, ast.Name) and node.id not in set(FUNCS) | set(CONSTANTS) | {'col'}:
            raise PlotError(f'unknown function or name {node.id!r}')
        if isinstance(node, ast.Call) and (not isinstance(node.func, ast.Name)
                                           or node.func.id not in set(FUNCS) | {'col'}
                                           or node.keywords):
            raise PlotError(f'unsupported function call in {spec!r}')
        if isinstance(node, ast.Constant) and type(node.value) not in (int, float):
            raise PlotError(f'non-numeric constant in {spec!r}')
    code = compile(tree, '<column expression>', 'eval')
    def evaluate(row):
        def col(n):
            if type(n) is not int or n < 1:
                raise ValueError('column numbers must be positive integers')
            return row[n - 1]
        return float(eval(code, {'__builtins__': {}}, {**FUNCS, **CONSTANTS, 'col': col}))
    return evaluate


def split_specs(value):
    parts, start, depth = [], 0, 0
    for i, char in enumerate(value):
        if char == '(':
            depth += 1
        elif char == ')':
            depth -= 1
        elif char == ',' and depth == 0:
            parts.append(value[start:i])
            start = i + 1
        if depth < 0:
            raise PlotError('unbalanced parentheses in -u')
    if depth:
        raise PlotError('unbalanced parentheses in -u')
    return parts + [value[start:]]


def numeric_pair(text, option):
    try:
        lo, hi = (float(s) for s in text.split(':'))
    except (ValueError, TypeError):
        raise PlotError(f'{option} requires MIN:MAX') from None
    if not math.isfinite(lo) or not math.isfinite(hi) or lo >= hi:
        raise PlotError(f'{option} requires finite MIN < MAX')
    return lo, hi


def initial_state():
    return dict(using=['1:2'], all=False, stype='xy', style='l', symbol=None,
                linewidth=2.0, pointsize=1.0, shift=None, legend_label=None, explicit_using=False)


def parse(argv):
    state = initial_state()
    opts = dict(x=None, y=None, lx=False, ly=False, title='', xt='', yt='',
                legend=None, dirs=None, size=(1024, 768), save=None, show=False,
                gui=True, palette=None, kind='xy', cmap='viridis', clim=None, clog=False,
                extent=None, aspect='auto', z=None, zt='', lz=False, cbt='',
                export=None, link=False, grid=True, stack_values=None, stack_axis=None, interpolate=None)
    files = []
    explicit_kind = False
    positional = False
    args = iter(argv)
    for arg in args:
        if positional:
            files.append((arg, copy.deepcopy(state)))
            continue
        if arg == '--':
            positional = True
            continue
        if arg in ('-h', '--help'):
            print(HELP)
            raise SystemExit(0)
        if arg == '-clist':
            colors = color_names()
            print('\n'.join(sorted(colors)))
            raise SystemExit(0)
        key, sep, inline = arg.partition('=')
        if key in ('--type', '--cmap', '--clim', '--extent', '--aspect', '--export', '--cb-label', '--zt', '--z', '--stack-values', '--stack-axis', '--interpolate'):
            value = inline if sep else next(args, None)
            if value is None:
                raise PlotError(f'{key} requires a value')
            name = {'--type':'kind', '--cb-label':'cbt', '--zt':'zt', '--z':'z'}.get(key, key[2:])
            if key == '--interpolate':
                if not re.fullmatch(r'[1-9]\d*', value):
                    raise PlotError('--interpolate requires a positive integer (e.g. 4)')
                value = int(value)
            elif key in ('--clim', '--z'):
                value = numeric_pair(value, key)
            elif key == '--extent':
                try:
                    value = tuple(float(v) for v in value.split(':'))
                except ValueError:
                    raise PlotError('--extent requires XMIN:XMAX:YMIN:YMAX') from None
                if len(value) != 4 or not all(math.isfinite(v) for v in value) or value[0] >= value[1] or value[2] >= value[3]:
                    raise PlotError('--extent requires finite increasing bounds')
            elif key == '--type' and value not in ('xy','image','intensity','scatter-color','line3d','scatter3d','surface'):
                raise PlotError('unknown plot type ' + value)
            elif key == '--aspect' and value not in ('auto','equal'):
                raise PlotError('--aspect must be auto or equal')
            opts[name.replace('-', '_')] = value
            if key == '--type':
                explicit_kind = True
            continue
        if arg in ('--clog', '--link-data', '--lz', '-lcb', '-lz'):
            opts[{'--clog':'clog','--link-data':'link','--lz':'lz', '-lcb':'clog', '-lz':'lz'}[arg]] = True
            continue
        if arg == '--no-gui':
            opts['gui'] = False
        elif arg == '--no-grid':
            opts['grid'] = False
        elif arg == '-show':
            opts['show'] = True
        elif arg.startswith('-L'):
            if not arg[2:]:
                raise PlotError('-L needs a legend label')
            state['legend_label'] = arg[2:]
            opts['legend'] = 'file'
        elif arg in ('-lx', '-ly'):
            opts[arg[1:]] = True
        elif arg == '-l':
            opts['legend'] = 'file'
        elif arg.startswith('-d'):
            suffix = arg[2:]
            if suffix and not suffix.isdigit():
                raise PlotError('-d accepts an optional positive integer')
            opts['legend'] = 'directory'
            opts['dirs'] = int(suffix) if suffix else None
        elif arg.startswith('-st'):
            value = arg[3:]
            if value not in ('xy', 'xydx', 'xydy', 'xydxdy'):
                raise PlotError('-st must be xy, xydx, xydy or xydxdy')
            state['stype'] = value
            state['explicit_using'] = False
            state['using'] = None
            state['all'] = False
        elif arg.startswith('-lw') or arg.startswith('-ps'):
            key = 'linewidth' if arg.startswith('-lw') else 'pointsize'
            try:
                state[key] = float(arg[3:])
            except ValueError:
                raise PlotError(f'{arg[:3]} needs a number') from None
            if not math.isfinite(state[key]) or state[key] < 0:
                raise PlotError(f'{arg[:3]} needs a nonnegative finite number')
        elif arg.startswith('-xt') or arg.startswith('-yt'):
            opts[arg[1:3]] = arg[3:]
        elif arg.startswith('-cbt'):
            opts['cbt'] = arg[4:]
        elif arg.startswith('-cb'):
            opts['clim'] = numeric_pair(arg[3:], '-cb')
        elif arg.startswith('-z'):
            opts['z'] = numeric_pair(arg[2:], '-z')
        elif arg.startswith('-x') or arg.startswith('-y'):
            opts[arg[1]] = numeric_pair(arg[2:], arg[:2])
        elif arg.startswith('-t'):
            opts['title'] = arg[2:]
        elif arg.startswith('-u'):
            value = arg[2:]
            state['explicit_using'] = True
            state['all'] = value == 'all'
            if value in ('one', '1'):
                state['using'] = None
            elif value == 'all':
                state['using'] = None
            else:
                state['using'] = split_specs(value)
                if not all(state['using']):
                    raise PlotError('-u needs nonempty column specifications')
        elif arg.startswith('-w'):
            m = re.fullmatch(r'(l|p|lp)(?::(\d+))?', arg[2:])
            if not m:
                raise PlotError('-w must be l, p, or lp, optionally :N')
            state['style'] = m[1]
            state['symbol'] = int(m[2]) if m[2] else None
        elif arg.startswith('-k'):
            try:
                state['shift'] = float(arg[2:])
            except ValueError:
                raise PlotError('-k needs a numeric shift') from None
            if not math.isfinite(state['shift']):
                raise PlotError('-k needs a finite shift')
        elif arg.startswith('-c'):
            opts['palette'] = arg[2:] or 'default'
        elif arg.startswith('-m'):
            value = arg[2:]
            if value:
                opts['size'] = page_size(value)
            else:
                opts['size'] = (1024, 768)
        elif arg.startswith('-s'):
            value = arg[2:]
            if not value:
                raise PlotError('-s needs a filename')
            opts['save'] = str(Path(value).with_suffix('.py'))
        elif arg == '-':
            files.append((arg, copy.deepcopy(state)))
        elif arg.startswith('-') and not Path(arg).is_file():
            raise PlotError(f'unknown option {arg!r}')
        else:
            files.append((arg, copy.deepcopy(state)))
    if opts['stack_values'] is not None:
        if explicit_kind and opts['kind'] != 'intensity':
            raise PlotError('--stack-values requires --type intensity')
        opts['kind'] = 'intensity'
        opts['stack_axis'] = opts['stack_axis'] or 'y'
        if opts['stack_axis'] not in ('x', 'y'):
            raise PlotError('--stack-axis must be x or y')
    elif opts['stack_axis'] is not None:
        raise PlotError('--stack-axis requires --stack-values')
    if opts['interpolate'] is not None and opts['stack_values'] is None:
        raise PlotError('--interpolate requires --stack-values')
    return opts, files, state


def page_size(value):
    try:
        w, h = (int(v) for v in value.split(':'))
    except ValueError:
        raise PlotError('-m needs WIDTH:HEIGHT in pixels') from None
    if w <= 0 or h <= 0:
        raise PlotError('-m dimensions must be positive')
    return w, h


def read_blocks(path):
    if path == '-':
        stream = sys.stdin
        close = False
    elif path.endswith('.gz'):
        stream = gzip.open(path, 'rt', encoding='utf-8')
        close = True
    else:
        stream = open(path, encoding='utf-8')
        close = True
    blocks, block = [], []
    try:
        for line_no, line in enumerate(stream, 1):
            stripped = line.strip()
            if not stripped or stripped == '&':
                if block:
                    blocks.append(block)
                    block = []
                continue
            if stripped.startswith('#') or stripped.startswith('@'):
                continue
            try:
                row = [float(v.replace('D', 'E').replace('d', 'e')) for v in stripped.split('#', 1)[0].split()]
            except ValueError:
                raise PlotError(f'{path}:{line_no}: expected numeric columns') from None
            block.append(row)
        if block:
            blocks.append(block)
    finally:
        if close:
            stream.close()
    return blocks


def palette_colors(value, n):
    if value is None:
        return [DEFAULT_SERIES_COLORS[i % len(DEFAULT_SERIES_COLORS)] for i in range(n)]
    colors = color_names()
    stops = PALETTES.get(value, value.split(':'))
    rgb = []
    for stop in stops:
        color = stop if re.fullmatch(r'#[0-9a-fA-F]{6}', stop) else colors.get(stop)
        if color is None:
            raise PlotError(f'unknown color {stop!r}; use -clist')
        rgb.append(tuple(bytes.fromhex(color[1:])))
    if len(rgb) == 1:
        rgb *= 2
    output = []
    for i in range(n):
        t = 0 if n == 1 else i * (len(rgb) - 1) / (n - 1)
        j = min(int(t), len(rgb) - 2)
        fraction = t - j
        color = tuple(round(a + fraction * (b - a)) for a, b in zip(rgb[j], rgb[j + 1]))
        output.append('#%02x%02x%02x' % color)
    return output



def prepare_stack(opts, files):
    """Assemble one XY curve per file into a parameter-resolved intensity map."""
    import numpy as np

    if len(files) < 2:
        raise PlotError('--stack-values requires at least two curve files')
    if opts['stack_values'] == '-':
        raise PlotError('--stack-values requires a named parameter file')
    for path, state in files:
        if (state['stype'] != 'xy' or state['all'] or state['shift'] is not None
                or len(state['using'] or ['1:2']) != 1):
            raise PlotError(f'{path}: stacked maps require one XY selection per file; no -k, -uall or error bars')

    parameter_rows = [row for block in read_blocks(opts['stack_values']) for row in block]
    if any(len(row) != 1 for row in parameter_rows):
        raise PlotError('--stack-values file must contain exactly one numeric column')
    parameters = [row[0] for row in parameter_rows]
    if len(parameters) != len(files):
        raise PlotError(f'parameter count ({len(parameters)}) must match curve file count ({len(files)})')
    if not all(math.isfinite(value) for value in parameters):
        raise PlotError('parameter values must be finite')
    if len(set(parameters)) != len(parameters):
        raise PlotError('parameter values must be distinct')

    reference = None
    columns = [[], [], []]
    xy_opts = dict(opts, kind='xy', stack_values=None)
    for parameter, (path, state) in zip(parameters, files):
        curves = prepare_series(xy_opts, [(path, state)])
        if len(curves) != 1:
            raise PlotError(f'{path}: expected exactly one data block/curve')
        coordinate, intensity = (np.asarray(col) for col in curves[0]['cols'])
        order = np.argsort(coordinate)
        coordinate, intensity = coordinate[order], intensity[order]
        if len(coordinate) < 2 or len(np.unique(coordinate)) != len(coordinate):
            raise PlotError(f'{path}: curve coordinates must contain at least two distinct samples and no duplicates')
        if reference is None:
            reference = coordinate
        elif len(coordinate) != len(reference) or not np.allclose(coordinate, reference, rtol=1e-10, atol=1e-12):
            raise PlotError(f'{path}: curve grid differs from the first file; resample explicitly before stacking')
        # Align coordinate round-off only; interpolation below acts on the parameter.
        for sample, value in zip(reference, intensity):
            x, y = (sample, parameter) if opts['stack_axis'] == 'y' else (parameter, sample)
            columns[0].append(float(x))
            columns[1].append(float(y))
            columns[2].append(float(value))
    if (opts.get('interpolate') or 1) > 1:
        xs, ys, grid = rectangular_grid(columns)
        parameters = ys if opts['stack_axis'] == 'y' else xs
        intensity = grid if opts['stack_axis'] == 'y' else grid.T
        fine_parameters = np.concatenate([
            np.linspace(left, right, opts['interpolate'], endpoint=False)
            for left, right in zip(parameters[:-1], parameters[1:])
        ] + [parameters[-1:]])
        fine_intensity = np.column_stack([
            np.interp(fine_parameters, parameters, values) for values in intensity.T
        ])
        if not np.all(np.isfinite(fine_intensity)):
            raise PlotError('non-finite interpolated intensity')
        if opts['stack_axis'] == 'y':
            xx, yy = np.meshgrid(xs, fine_parameters)
            zz = fine_intensity
        else:
            xx, yy = np.meshgrid(fine_parameters, ys)
            zz = fine_intensity.T
        columns = [xx.ravel().tolist(), yy.ravel().tolist(), zz.ravel().tolist()]
    return [dict(path='stack: ' + opts['stack_values'], block=1, blocks=1,
                 spec='1:2:3', state=initial_state(), cols=columns)]


def prepare_series(opts, files):
    if opts.get('stack_values') is not None:
        return prepare_stack(opts, files)
    series = []
    kind = opts['kind']
    if kind != 'xy' and any(state['stype'] != 'xy' or state['all'] for _,state in files):
        raise PlotError('-st error bars and -uall are only supported for XY plots')
    if kind in ('image','intensity','surface') and len(files) != 1:
        raise PlotError('image, intensity and surface require one input file')
    for path, state in files:
        blocks = read_blocks(path)
        if kind in ('image','intensity','surface'):
            blocks = [[row for block in blocks for row in block]]
        for block_no, block in enumerate(blocks, 1):
            if not block:
                continue
            if kind == 'image':
                if state['explicit_using']:
                    raise PlotError('image reads a matrix; do not specify -u')
                if len({len(row) for row in block}) != 1:
                    raise PlotError('image requires a rectangular matrix')
                cols = block
                if any(not math.isfinite(v) for row in block for v in row):
                    raise PlotError('image contains non-finite values')
                series.append(dict(path=path,block=1,blocks=1,spec='matrix',state=state,cols=cols))
                continue
            expected = (4 if state['stype']=='xydxdy' else 3 if state['stype']!='xy' else 2) if kind=='xy' else 3
            using = state['using']
            if state['all']:
                if len(block[0]) < 2:
                    raise PlotError('-uall requires at least two columns')
                using = [f'1:{n}' for n in range(2,len(block[0])+1)]
            elif using is None or (kind != 'xy' and not state['explicit_using']):
                using = [':'.join(str(i) for i in range(1,expected+1))]
                if kind=='xy' and expected==2 and len(block[0])==1:
                    using=['index:$1']
            for spec in using:
                parts=spec.split(':')
                if len(parts)!=expected:
                    raise PlotError(f'{path}: {kind}/{state["stype"]} requires {expected} columns in {spec!r}')
                funcs=[None if p=='index' else expression(p) for p in parts]
                cols=[[] for _ in funcs]
                for row_no,row in enumerate(block,1):
                    try:
                        values=[float(fn(row)) if fn else float(row_no-1) for fn in funcs]
                    except (IndexError,ValueError,OverflowError,ZeroDivisionError,TypeError) as exc:
                        raise PlotError(f'{path}, block {block_no}, row {row_no}: {exc}') from exc
                    if any(not math.isfinite(v) for v in values):
                        raise PlotError(f'{path}, block {block_no}, row {row_no}: non-finite value')
                    if kind=='xy' and any(v<0 for v in values[2:]):
                        raise PlotError(f'{path}: negative error bar')
                    values[1] += (state['shift'] or 0)*len(series)
                    if not math.isfinite(values[1]):
                        raise PlotError(f'{path}: non-finite shifted value')
                    for col,v in zip(cols,values):col.append(v)
                series.append(dict(path=path,block=block_no,blocks=len(blocks),spec=spec,state=state,cols=cols))
    if not series:
        raise PlotError('no numeric data to plot')
    if kind in ('intensity','surface') and len(series)!=1:
        raise PlotError('intensity/surface require one x:y:z selection')
    return series


def rectangular_grid(cols):
    import numpy as np
    x,y,z=map(np.asarray,cols)
    xs,ys=np.unique(x),np.unique(y)
    if len(xs)<2 or len(ys)<2:
        raise PlotError('grid requires at least two distinct x and y coordinates')
    pairs=set(zip(x,y))
    if len(pairs)!=len(x):
        raise PlotError('duplicate (x,y) grid coordinates')
    if len(x)!=len(xs)*len(ys):
        raise PlotError('incomplete rectangular grid; use scatter-color for scattered data')
    grid=np.empty((len(ys),len(xs)))
    grid[np.searchsorted(ys,y),np.searchsorted(xs,x)]=z
    return xs,ys,grid


def build_figure(opts, series):
    import numpy as np
    import matplotlib as mpl
    import matplotlib.pyplot as plt
    from matplotlib.colors import LogNorm, Normalize
    kind=opts['kind']
    is3d=kind in ('line3d','scatter3d','surface')
    fig=plt.figure(figsize=(opts['size'][0]/100,opts['size'][1]/100),layout='constrained')
    with plt.rc_context({'grid.color': '#eeeeee', 'grid.linewidth': 0.6}):
        ax=fig.add_subplot(111,projection='3d' if is3d else None)
    colors=palette_colors(opts['palette'],len(series))
    markers=['o','s','D','^','v','+','x','*','p','h']
    groups=[]
    colorplots=kind in ('image','intensity','scatter-color','surface')
    norm=None
    if colorplots:
        if opts['cmap'] not in mpl.colormaps:
            raise PlotError('unknown colormap ' + opts['cmap'])
        vals=np.concatenate([np.asarray(item['cols'] if kind=='image' else item['cols'][2]).ravel() for item in series])
        if opts['clog'] and (np.any(vals<=0) or (opts['clim'] and opts['clim'][0]<=0)):
            raise PlotError('logarithmic colors require positive values and limits')
        low,high=opts['clim'] or (float(vals.min()),float(vals.max()))
        if low==high:
            low,high=(low/2,high*2) if opts['clog'] else (low-0.5,high+0.5)
        norm=(LogNorm if opts['clog'] else Normalize)(vmin=low,vmax=high)
    for i,item in enumerate(series):
        state=item['state']
        label=state['legend_label']
        if label is None:
            path=Path(item['path'])
            label=str(path.parent) if opts['legend']=='directory' else path.name
            if opts['legend']=='directory' and opts['dirs']:
                label=str(Path(*path.parent.parts[:opts['dirs']]))
            if item['blocks']>1:label+=f' set {item["block"]}'
            label+=' '+item['spec']
        cols=[np.asarray(c) for c in item['cols']]
        if kind!='image':
            for j,axis in enumerate(('x','y','z')[:3 if is3d else 2]):
                if opts.get('l'+axis) and np.any(cols[j]<=0):
                    raise PlotError(f'logarithmic {axis} axis requires positive coordinates')
        symbol=state['symbol']
        if symbol is not None and not 0<=symbol<=10:
            raise PlotError('symbol number must be between 0 and 10')
        marker=markers[(symbol-1 if symbol else i)%len(markers)] if state['style']!='l' and symbol!=0 else None
        style=dict(color=colors[i],linewidth=state['linewidth'],marker=marker,
                   markersize=3*state['pointsize'],linestyle='None' if state['style']=='p' else '-',label=label)
        if kind=='xy':
            x,y,*errors=cols
            if errors:
                xerr=errors[0] if state['stype'] in ('xydx','xydxdy') else None
                yerr=errors[-1] if state['stype'] in ('xydy','xydxdy') else None
                artist=ax.errorbar(x,y,xerr=xerr,yerr=yerr,**style)
                members=[artist.lines[0],*artist.lines[1],*artist.lines[2]]
                line=artist.lines[0]
            else:
                line,=ax.plot(x,y,**style);members=[line]
            line.set_picker(5)
            groups.append((line,members,label))
        elif kind=='line3d':
            line,=ax.plot(*cols,**style)
            groups.append((line,[line],label))
        elif kind=='scatter3d':
            artist=ax.scatter(*cols,color=colors[i],s=(3*state['pointsize'])**2,label=label)
            groups.append((artist,[artist],label))
        elif kind=='scatter-color':
            artist=ax.scatter(cols[0],cols[1],c=cols[2],cmap=opts['cmap'],norm=norm,s=(3*state['pointsize'])**2,picker=5)
        elif kind=='image':
            artist=ax.imshow(np.asarray(cols),origin='lower',extent=opts['extent'],aspect=opts['aspect'],interpolation='nearest',cmap=opts['cmap'],norm=norm)
        else:
            xs,ys,z=rectangular_grid(cols)
            if kind=='intensity':
                artist=ax.pcolormesh(xs,ys,z,shading='nearest',cmap=opts['cmap'],norm=norm)
            else:
                xx,yy=np.meshgrid(xs,ys)
                artist=ax.plot_surface(xx,yy,z,rcount=len(ys),ccount=len(xs),cmap=opts['cmap'],norm=norm)
    if colorplots:fig.colorbar(artist,ax=ax,label=opts['cbt'])
    if is3d:
        ax.grid(opts['grid'])
    else:
        ax.set_axisbelow(True)
        if opts['grid']:
            ax.grid(True, color='#eeeeee', linewidth=0.6)
        else:
            ax.grid(False)
    ax.set_title(opts['title']);ax.set_xlabel(opts['xt']);ax.set_ylabel(opts['yt'])
    if is3d:ax.set_zlabel(opts['zt'])
    elif kind!='image':ax.set_aspect(opts['aspect'])
    for axis in ('x','y','z') if is3d else ('x','y'):
        if opts.get('l'+axis):
            if opts.get(axis) and opts[axis][0]<=0:
                raise PlotError(f'logarithmic {axis} limits must be positive')
            getattr(ax,'set_'+axis+'scale')('log')
        if opts.get(axis):getattr(ax,'set_'+axis+'lim')(*opts[axis])
    if opts['legend'] and groups:
        legend=ax.legend(handles=[g[0] for g in groups],labels=[g[2] for g in groups])
        mapping={}
        for proxy,(_,members,_) in zip(legend.legend_handles,groups):
            proxy.set_picker(5);mapping[proxy]=members
        def toggle(event):
            if event.artist in mapping:
                members=mapping[event.artist];visible=not members[0].get_visible()
                for member in members:member.set_visible(visible)
                event.artist.set_alpha(1 if visible else .2);fig.canvas.draw_idle()
        fig.canvas.mpl_connect('pick_event',toggle)
    if kind=='xy':
        annotation=ax.annotate('',xy=(0,0),xytext=(12,12),textcoords='offset points',bbox=dict(boxstyle='round',fc='white',alpha=.9))
        annotation.set_visible(False)
        def inspect(event):
            for line,_,label in groups:
                if event.artist is line and len(event.ind):
                    n=int(event.ind[0]);x,y=line.get_data();annotation.xy=(x[n],y[n])
                    annotation.set_text(f'{label}\nindex={n}, x={x[n]:.8g}, y={y[n]:.8g}')
                    annotation.set_visible(True);fig.canvas.draw_idle();break
        fig.canvas.mpl_connect('pick_event',inspect)
    return fig,ax


def script_column(spec, data='data'):
    """Translate a validated selection into readable, ordinary Python code."""
    if spec == 'index':
        return f'np.arange(len({data}), dtype=float)'
    if re.fullmatch(r'[1-9]\d*', spec):
        return f'{data}[:, {int(spec) - 1}]'
    translated = re.sub(r'\$(\d+)', lambda match: f'col({int(match[1])})',
                        spec.replace('^', '**'))
    tree = ast.parse(translated, mode='eval')

    class ColumnNames(ast.NodeTransformer):
        def visit_Call(self, node):
            if isinstance(node.func, ast.Name) and node.func.id == 'col':
                index = self.visit(node.args[0])
                offset = (ast.Constant(value=index.value - 1)
                          if isinstance(index, ast.Constant) and type(index.value) is int
                          else ast.BinOp(left=index, op=ast.Sub(), right=ast.Constant(value=1)))
                return ast.Subscript(value=ast.Name(id='row', ctx=ast.Load()),
                                     slice=offset, ctx=ast.Load())
            return self.generic_visit(node)

        def visit_Name(self, node):
            if node.id in CONSTANTS or (node.id in FUNCS and node.id not in ('abs', 'min', 'max', 'pow')):
                return ast.Attribute(value=ast.Name(id='math', ctx=ast.Load()),
                                     attr=node.id, ctx=ast.Load())
            return node

    result = ast.unparse(ast.fix_missing_locations(ColumnNames().visit(tree)))
    return f'np.array([{result} for row in {data}], dtype=float)'


def emit_linked_stack(add, opts, files):
    """Emit plain, editable code to reload curves and their parameter values."""
    add('    # One parameter per source, paired in command-line order.')
    add('    parameter_blocks = read_data(PARAMETER_SOURCE)')
    add('    if any(block.shape[1] != 1 for block in parameter_blocks):')
    add("        raise ValueError('Parameter file must contain exactly one column')")
    add('    parameters = np.concatenate(parameter_blocks, axis=0)[:, 0]')
    add(f'    if len(parameters) != {len(files)}:')
    add("        raise ValueError('Parameter count must match the number of curve files')")
    add('    if not np.all(np.isfinite(parameters)):')
    add("        raise ValueError('Non-finite parameter value')")
    add('    if len(np.unique(parameters)) != len(parameters):')
    add("        raise ValueError('Duplicate parameter values')")
    for i, (_, state) in enumerate(files, 1):
        selection = (state['using'] or ['1:2'])[0]
        parts = selection.split(':')
        add()
        add(f'    # Curve {i}, paired with parameters[{i - 1}].')
        add(f'    blocks = read_data(SOURCE_{i})')
        add('    if len(blocks) != 1:')
        add("        raise ValueError('Each curve file must contain exactly one data block')")
        add('    data = blocks[0]')
        add('    coordinate = ' + script_column(parts[0]))
        add('    intensity = ' + script_column(parts[1]))
        add('    if not np.all(np.isfinite(coordinate)) or not np.all(np.isfinite(intensity)):')
        add("        raise ValueError('Non-finite curve data or expression result')")
        add('    order = np.argsort(coordinate)')
        add('    coordinate = coordinate[order]')
        add(f'    intensity_{i} = intensity[order]')
        add('    if len(coordinate) < 2 or len(np.unique(coordinate)) != len(coordinate):')
        add("        raise ValueError('Curve coordinates need at least two samples and no duplicates')")
        if i == 1:
            add('    samples = coordinate')
        else:
            add('    if len(coordinate) != len(samples) or not np.allclose(coordinate, samples, rtol=1e-10, atol=1e-12):')
            add(f"        raise ValueError('Curve {i} grid differs from the first file; resample explicitly')")
    add()
    add('    # Sort the parameter axis while keeping every curve paired with its value.')
    add('    order = np.argsort(parameters)')
    add('    parameters = parameters[order]')
    add('    intensity = np.vstack([' + ', '.join(f'intensity_{i}' for i in range(1, len(files) + 1)) + '])[order]')
    if (opts.get('interpolate') or 1) > 1:
        add()
        add('    # Linear interpolation in the physical parameter, not in the colors.')
        add('    # Original samples are retained; there is no extrapolation.')
        add(f'    subdivisions = {opts["interpolate"]}')
        add('    fine_parameters = np.concatenate([')
        add('        np.linspace(left, right, subdivisions, endpoint=False)')
        add('        for left, right in zip(parameters[:-1], parameters[1:])')
        add('    ] + [parameters[-1:]])')
        add('    intensity = np.column_stack([')
        add('        np.interp(fine_parameters, parameters, values)')
        add('        for values in intensity.T')
        add('    ])')
        add('    if not np.all(np.isfinite(intensity)):')
        add("        raise ValueError('Non-finite interpolated intensity')")
        add('    parameters = fine_parameters')
    if opts['stack_axis'] == 'y':
        add('    x, y, z = samples, parameters, intensity  # One curve per row.')
    else:
        add('    x, y, z = parameters, samples, intensity.T  # One curve per column.')
    for axis in ('x', 'y'):
        if opts['l' + axis]:
            add(f'    if np.any({axis} <= 0):')
            add(f"        raise ValueError('Logarithmic {axis} requires positive coordinates')")
    add()


def make_script(opts, files, series):
    """Write the actual plot, rather than serializing mplot's implementation."""
    import textwrap

    kind = opts['kind']
    stacked = opts.get('stack_values') is not None
    is3d = kind in ('line3d', 'scatter3d', 'surface')
    colored = kind in ('image', 'intensity', 'scatter-color', 'surface')
    colors = palette_colors(opts['palette'], len(series))
    markers = ['o', 's', 'D', '^', 'v', '+', 'x', '*', 'p', 'h']
    lines = [
        '#!/usr/bin/env python3',
        '"""Editable plot generated by mplot.',
        '',
        'Requires NumPy and Matplotlib >= 3.7; does not require mplot.',
        'Run: python3 figure.py [--no-gui] [--export figure.pdf]',
        'Edit the data below and the Matplotlib calls in create_figure().',
        '"""',
        'import numpy as np',
    ]
    source_paths = [path for path, _ in files] + ([opts['stack_values']] if stacked else [])
    if opts['link']:
        selections = [(state['using'] or ['1:2'])[0] for _, state in files] if stacked else [item['spec'] for item in series]
        if kind != 'image' and any('math.' in script_column(part)
                                   for selection in selections for part in selection.split(':')):
            lines.append('import math')
        if any(path.endswith('.gz') for path in source_paths):
            lines.append('import gzip')
    if colored:
        lines.append('from matplotlib.colors import LogNorm' if opts['clog']
                     else 'from matplotlib.colors import Normalize')

    def add(text=''):
        lines.append(text)

    def array(name, values):
        """One table row per source row, with whitespace-delimited numbers."""
        add(f'{name} = np.array([')
        for row in values:
            numbers = ', '.join(repr(float(value)) for value in row)
            add(f'    [{numbers}],')
        add('], dtype=float)')

    add()
    add('# 1. Data. Columns are identified below; values retain float64 precision.')
    if opts['link']:
        add('# These source paths are absolute. Edit them if you move the data files.')
        for i, (path, _) in enumerate(files, 1):
            add(f'SOURCE_{i} = {str(Path(path).resolve())!r}')
        if stacked:
            add(f'PARAMETER_SOURCE = {str(Path(opts["stack_values"]).resolve())!r}')
        add()
        add(textwrap.dedent('''\
            def read_data(path):
                """Read numeric blocks, including comments and Fortran D exponents."""
                blocks = []
                rows = []
                OPEN_STREAM
                with stream:
                    for line_number, line in enumerate(stream, start=1):
                        text = line.strip()
                        if not text or text == '&':
                            if rows:
                                blocks.append(np.array(rows, dtype=float))
                                rows = []
                            continue
                        if text.startswith(('#', '@')):
                            continue
                        try:
                            row = [float(v.replace('D', 'E').replace('d', 'e'))
                                   for v in text.split('#', 1)[0].split()]
                        except ValueError as exc:
                            raise ValueError(f'{path}:{line_number}: invalid numeric row') from exc
                        if rows and len(row) != len(rows[0]):
                            raise ValueError(f'{path}:{line_number}: inconsistent column count')
                        rows.append(row)
                if rows:
                    blocks.append(np.array(rows, dtype=float))
                if not blocks:
                    raise ValueError(f'{path}: no numeric data')
                return blocks
            ''').replace('OPEN_STREAM',
                         "stream = gzip.open(path, 'rt') if path.endswith('.gz') else open(path)"
                         if any(path.endswith('.gz') for path in source_paths)
                         else 'stream = open(path)'))
    else:
        for i, item in enumerate(series, 1):
            source = f'{item["path"]}, block {item["block"]}, selection {item["spec"]}'
            add('# ' + source.replace('\n', ' ').replace('\r', ' '))
            if stacked and (opts.get('interpolate') or 1) > 1:
                add(f'# Includes linear interpolation along the parameter axis: factor {opts["interpolate"]}.')
            if kind == 'image':
                array(f'image_{i}', item['cols'])
            elif kind in ('intensity', 'surface'):
                xs, ys, grid = rectangular_grid(item['cols'])
                add(f'x_{i} = np.array({xs.tolist()!r}, dtype=float)')
                add(f'y_{i} = np.array({ys.tolist()!r}, dtype=float)')
                add('# Rows follow y; columns follow x.')
                array(f'z_{i}', grid)
            else:
                headings = ['x', 'y']
                if kind != 'xy':
                    headings.append('z')
                elif item['state']['stype'] == 'xydxdy':
                    headings.extend(['x_error', 'y_error'])
                elif item['state']['stype'] != 'xy':
                    headings.append('x_error' if item['state']['stype'] == 'xydx' else 'y_error')
                add('# Columns: ' + ', '.join(headings))
                array(f'data_{i}', zip(*item['cols']))
            add()

    if opts['link'] and kind in ('intensity', 'surface') and not stacked:
        add(textwrap.dedent('''\
            def make_grid(x, y, z):
                """Reorder a complete rectangular grid without interpolating."""
                xs = np.unique(x)
                ys = np.unique(y)
                if len(xs) < 2 or len(ys) < 2:
                    raise ValueError('Grid needs at least two x and y coordinates')
                if len(set(zip(x, y))) != len(x):
                    raise ValueError('Duplicate grid coordinates')
                if len(x) != len(xs) * len(ys):
                    raise ValueError('Incomplete rectangular grid')
                grid = np.empty((len(ys), len(xs)))
                grid[np.searchsorted(ys, y), np.searchsorted(xs, x)] = z
                return xs, ys, grid
            '''))

    add()
    add('def create_figure():')
    add('    """Change labels, limits and styles directly in the calls below."""')
    add('    import matplotlib.pyplot as plt')
    add()
    add('    # 2. Figure dimensions in inches (100 dpi).')
    size = (opts['size'][0] / 100, opts['size'][1] / 100)
    if is3d:
        add(f"    fig = plt.figure(figsize={size!r}, layout='constrained')")
        add("    with plt.rc_context({'grid.color': '#eeeeee', 'grid.linewidth': 0.6}):")
        add("        ax = fig.add_subplot(111, projection='3d')")
    else:
        add(f"    fig, ax = plt.subplots(figsize={size!r}, layout='constrained')")
    if kind == 'xy' or (opts['legend'] and kind in ('line3d', 'scatter3d')):
        add('    curves = []  # Used only by the mouse interactions at the end.')
    add()
    add('    # 3. Prepare coordinates and draw the plot.')
    if opts['link'] and stacked:
        emit_linked_stack(add, opts, files)
    elif opts['link']:
        for i, (path, _) in enumerate(files, 1):
            add(f'    blocks_{i} = read_data(SOURCE_{i})')
            if kind in ('image', 'intensity', 'surface'):
                add(f'    blocks_{i} = [np.concatenate(blocks_{i}, axis=0)]')
        # A changing number of blocks or -uall columns must update curves and palette.
        counts = []
        for i, (_, state) in enumerate(files, 1):
            n = f'(block.shape[1] - 1)' if state['all'] else str(len(state['using'] or [None]))
            counts.append(f'sum({n} for block in blocks_{i})')
        add('    curve_count = ' + ' + '.join(counts))
        if opts['palette']:
            palette = PALETTES.get(opts['palette'], opts['palette'].split(':'))
            resolved = [stop if stop.startswith('#') else color_names()[stop] for stop in palette]
            if len(resolved) == 1:
                resolved *= 2
            add('    from matplotlib.colors import LinearSegmentedColormap, to_hex')
            add(f'    palette = LinearSegmentedColormap.from_list("curves", {resolved!r}, N=65536)')
            add('    colors = [to_hex(palette(i / max(curve_count - 1, 1)))')
            add('              for i in range(curve_count)]')
        else:
            add(f'    colors = {list(DEFAULT_SERIES_COLORS)!r}')
        add('    curve_index = 0')

    # Share color normalization, including data-dependent limits on linked inputs.
    if colored:
        if opts['link']:
            if stacked:
                add('    color_values = z.ravel()')
            elif kind == 'image':
                add('    color_values = blocks_1[0].ravel()')
            else:
                color_exprs = []
                for i, (_, state) in enumerate(files, 1):
                    using = state['using'] if state['explicit_using'] else ['1:2:3']
                    for selection in using:
                        z_expr = script_column(selection.split(':')[2], 'block')
                        color_exprs.append(f'[{z_expr} for block in blocks_{i}]')
                add('    color_values = np.concatenate(' + ' + '.join(color_exprs) + ')')
            add('    if not np.all(np.isfinite(color_values)):')
            add("        raise ValueError('Non-finite color values')")
            if opts['clog']:
                add('    if np.any(color_values <= 0):')
                add("        raise ValueError('Logarithmic colors require positive values')")
            if opts['clim']:
                add(f'    color_min, color_max = {opts["clim"]!r}')
            else:
                add('    color_min = float(color_values.min())')
                add('    color_max = float(color_values.max())')
                add('    if color_min == color_max:')
                if opts['clog']:
                    add('        color_min, color_max = color_min / 2, color_max * 2')
                else:
                    add('        color_min, color_max = color_min - 0.5, color_max + 0.5')
        else:
            values = [v for item in series for row in item['cols'] for v in row] if kind == 'image' else [v for item in series for v in item['cols'][2]]
            lo, hi = opts['clim'] or (min(values), max(values))
            if lo == hi:
                lo, hi = (lo / 2, hi * 2) if opts['clog'] else (lo - 0.5, hi + 0.5)
            add('    # Edit these bounds to change the color scale.')
            add(f'    color_min, color_max = {lo!r}, {hi!r}')
        norm = 'LogNorm' if opts['clog'] else 'Normalize'
        add(f'    color_scale = {norm}(vmin=color_min, vmax=color_max)')
        add()

    def label_for(item):
        state = item['state']
        if state['legend_label'] is not None:
            return state['legend_label']
        path = Path(item['path'])
        label = str(path.parent) if opts['legend'] == 'directory' else path.name
        if opts['legend'] == 'directory' and opts['dirs']:
            label = str(Path(*path.parent.parts[:opts['dirs']]))
        if item['blocks'] > 1:
            label += f' set {item["block"]}'
        return label + ' ' + item['spec']

    def draw(state, label, color, marker, indent='    '):
        """Emit only the Matplotlib call needed for this plot type."""
        def emit(text=''):
            add(indent + text if text else '')
        style = [f'color={color}', f'linewidth={state["linewidth"]!r}',
                 f'linestyle={"None" if state["style"] == "p" else "-"!r}',
                 f'marker={marker}', f'markersize={3 * state["pointsize"]!r}',
                 f'label={label}']
        if kind in ('xy', 'line3d'):
            errors = []
            if kind == 'xy':
                if state['stype'] in ('xydx', 'xydxdy'):
                    errors.append('xerr=x_error')
                if state['stype'] in ('xydy', 'xydxdy'):
                    errors.append('yerr=y_error')
            coordinates = 'x, y, z' if kind == 'line3d' else 'x, y'
            emit(f'{"errorbars = ax.errorbar" if errors else "line, = ax.plot"}(')
            emit('    ' + coordinates + ',')
            for param in errors + style:
                emit('    ' + param + ',')
            emit(')')
            if errors:
                emit('line = errorbars.lines[0]')
                emit('members = [line, *errorbars.lines[1], *errorbars.lines[2]]')
            else:
                emit('members = [line]')
            if kind == 'xy':
                emit('line.set_picker(5)  # Click within five points of a data point.')
            if kind == 'xy' or opts['legend']:
                emit('curves.append((line, members))')
        elif kind == 'scatter3d':
            emit('points = ax.scatter(')
            emit(f'    x, y, z, color={color}, s={(3 * state["pointsize"]) ** 2!r},')
            emit(f'    label={label},')
            emit(')')
            if opts['legend']:
                emit('curves.append((points, [points]))')
        else:
            method = {'image': 'imshow', 'intensity': 'pcolormesh',
                      'surface': 'plot_surface', 'scatter-color': 'scatter'}[kind]
            if kind == 'surface':
                emit('xx, yy = np.meshgrid(x, y)')
            emit(f'colored_plot = ax.{method}(')
            coords = {'image': 'image', 'intensity': 'x, y, z',
                      'surface': 'xx, yy, z', 'scatter-color': 'x, y, c=z'}[kind]
            emit('    ' + coords + ',')
            emit(f'    cmap={opts["cmap"]!r}, norm=color_scale,')
            if kind == 'image':
                emit(f'    origin="lower", extent={opts["extent"]!r},')
                emit(f'    interpolation="nearest", aspect={opts["aspect"]!r},')
            elif kind == 'intensity':
                emit('    shading="nearest",  # Cells are centered on the samples.')
            elif kind == 'surface':
                emit('    rcount=len(y), ccount=len(x),  # Keep all grid points.')
            else:
                emit(f'    s={(3 * state["pointsize"]) ** 2!r},')
            emit(')')

    if not opts['link']:
        for i, item in enumerate(series, 1):
            state = item['state']
            add('    # ' + label_for(item).replace('\n', ' ').replace('\r', ' '))
            if kind == 'image':
                add(f'    image = image_{i}')
            elif kind in ('intensity', 'surface'):
                add(f'    x, y, z = x_{i}, y_{i}, z_{i}')
            else:
                names = ['x', 'y']
                if kind != 'xy':
                    names.append('z')
                elif state['stype'] == 'xydxdy':
                    names.extend(['x_error', 'y_error'])
                elif state['stype'] != 'xy':
                    names.append('x_error' if state['stype'] == 'xydx' else 'y_error')
                for column, name in enumerate(names):
                    add(f'    {name} = data_{i}[:, {column}]')
            symbol = state['symbol']
            marker = markers[(symbol - 1 if symbol else i - 1) % len(markers)] if state['style'] != 'l' and symbol != 0 else None
            draw(state, repr(label_for(item)), repr(colors[i - 1]), repr(marker))
            add()
    elif stacked:
        draw(series[0]['state'], repr('stacked curves'), repr(colors[0]), 'None')
        add()
    else:
        for i, (path, state) in enumerate(files, 1):
            add(f'    # Source {i}: change column selections and formulas here.')
            add(f'    for block_number, data in enumerate(blocks_{i}, start=1):')
            if state['all']:
                add('        if data.shape[1] < 2:')
                add("            raise ValueError('-uall requires at least two columns')")
                add('        for y_column in range(1, data.shape[1]):')
                selections = [('1:dynamic', ['data[:, 0]', 'data[:, y_column]'], '            ')]
            else:
                expected = 3 if kind != 'xy' else (4 if state['stype'] == 'xydxdy' else 2 if state['stype'] == 'xy' else 3)
                specs = state['using'] if state['explicit_using'] and state['using'] else [':'.join(map(str, range(1, expected + 1)))]
                selections = [(selection, [script_column(part) for part in selection.split(':')], '        ')
                              for selection in specs] if kind != 'image' else [('matrix', [], '        ')]
            for selection, expressions, indent in selections:
                def emit(text):
                    add(indent + text)
                if kind == 'image':
                    emit('image = data')
                    names = ['image']
                else:
                    names = ['x', 'y']
                    if kind != 'xy':
                        names.append('z')
                    elif state['stype'] == 'xydxdy':
                        names.extend(['x_error', 'y_error'])
                    elif state['stype'] != 'xy':
                        names.append('x_error' if state['stype'] == 'xydx' else 'y_error')
                    for name, value in zip(names, expressions):
                        if name == 'x' and state['using'] is None and kind == 'xy' and state['stype'] == 'xy':
                            value = f'{value} if data.shape[1] > 1 else np.arange(len(data), dtype=float)'
                        if name == 'y' and state['using'] is None and kind == 'xy' and state['stype'] == 'xy':
                            value = f'{value} if data.shape[1] > 1 else data[:, 0]'
                        emit(f'{name} = {value}')
                    if state['shift']:
                        emit(f'y = y + {state["shift"]!r} * curve_index')
                emit('if not all(np.all(np.isfinite(values)) for values in [' + ', '.join(names) + ']):')
                emit("    raise ValueError('Non-finite data or expression result')")
                for name in names:
                    if name.endswith('_error'):
                        emit(f'if np.any({name} < 0):')
                        emit("    raise ValueError('Negative error bars')")
                for axis in ('x', 'y', 'z') if is3d else ('x', 'y'):
                    if opts.get('l' + axis) and kind != 'image':
                        emit(f'if np.any({axis} <= 0):')
                        emit(f"    raise ValueError('Logarithmic {axis} requires positive coordinates')")
                if kind in ('intensity', 'surface'):
                    emit('x, y, z = make_grid(x, y, z)')
                if state['legend_label'] is not None:
                    label = repr(state['legend_label'])
                else:
                    item = dict(path=path, state=state, block=1, blocks=1, spec='')
                    base = label_for(item).rstrip()
                    emit(f'label = {base!r}')
                    emit(f'if len(blocks_{i}) > 1:')
                    emit('    label += f" set {block_number}"')
                    if state['all']:
                        emit('label += f" 1:{y_column + 1}"')
                    else:
                        emit(f'label += {" " + selection!r}')
                    label = 'label'
                if state['style'] != 'l' and state['symbol'] != 0:
                    marker = repr(markers[(state['symbol'] - 1) % len(markers)]) if state['symbol'] else f'{markers!r}[curve_index % 10]'
                else:
                    marker = 'None'
                draw(state, label, 'colors[curve_index % len(colors)]', marker, indent)
                emit('curve_index += 1')
                add()

    if colored:
        add('    fig.colorbar(colored_plot, ax=ax, label=' + repr(opts['cbt']) + ')')
        add()
    add('    # 4. Labels, scales and limits. Uncomment limits to fix the visible range.')
    add('    # Very light gray grid; use ax.grid(False) to remove it.')
    if is3d:
        add(f'    ax.grid({opts["grid"]!r})')
    else:
        add('    ax.set_axisbelow(True)')
        if opts['grid']:
            add("    ax.grid(True, color='#eeeeee', linewidth=0.6)")
        else:
            add('    ax.grid(False)')
    add(f'    ax.set_title({opts["title"]!r})')
    add(f'    ax.set_xlabel({opts["xt"]!r})')
    add(f'    ax.set_ylabel({opts["yt"]!r})')
    if is3d:
        add(f'    ax.set_zlabel({opts["zt"]!r})')
    elif kind != 'image':
        add(f'    ax.set_aspect({opts["aspect"]!r})')
    for axis in ('x', 'y', 'z') if is3d else ('x', 'y'):
        if opts.get('l' + axis):
            add(f'    ax.set_{axis}scale("log")')
        if opts.get(axis):
            add(f'    ax.set_{axis}lim{opts[axis]!r}')
        else:
            add(f'    # ax.set_{axis}lim(0, 1)')
    if opts['legend'] and kind in ('xy', 'line3d', 'scatter3d'):
        add('    legend = ax.legend(handles=[curve for curve, _ in curves])')
        add('    enable_legend_toggle(fig, legend, curves)')
    if kind == 'xy':
        add('    enable_point_inspection(fig, ax, curves)')
    add('    return fig, ax')
    add()
    add()
    if kind == 'xy' or (opts['legend'] and kind in ('line3d', 'scatter3d')):
        add('# 5. Optional mouse interactions. Remove these calls/functions if not needed.')
    if opts['legend'] and kind in ('xy', 'line3d', 'scatter3d'):
        add(textwrap.dedent('''\
            def enable_legend_toggle(fig, legend, curves):
                """Click a legend symbol to show/hide a curve and its error bars."""
                mapping = {}
                for symbol, (_, members) in zip(legend.legend_handles, curves):
                    symbol.set_picker(5)
                    mapping[symbol] = members

                def on_pick(event):
                    if event.artist not in mapping:
                        return
                    members = mapping[event.artist]
                    visible = not members[0].get_visible()
                    for member in members:
                        member.set_visible(visible)
                    event.artist.set_alpha(1 if visible else 0.2)
                    fig.canvas.draw_idle()

                fig.canvas.mpl_connect('pick_event', on_pick)
            '''))
    if kind == 'xy':
        add(textwrap.dedent('''\
            def enable_point_inspection(fig, ax, curves):
                """Click near an XY point to display its index and coordinates."""
                note = ax.annotate(
                    '', xy=(0, 0), xytext=(12, 12), textcoords='offset points',
                    bbox=dict(boxstyle='round', facecolor='white', alpha=0.9),
                )
                note.set_visible(False)

                def on_pick(event):
                    for curve, _ in curves:
                        if event.artist is not curve or not len(event.ind):
                            continue
                        index = int(event.ind[0])
                        x, y = curve.get_data()
                        note.xy = (x[index], y[index])
                        note.set_text(
                            f'{curve.get_label()}\\n'
                            f'index={index}, x={x[index]:.8g}, y={y[index]:.8g}'
                        )
                        note.set_visible(True)
                        fig.canvas.draw_idle()
                        break

                fig.canvas.mpl_connect('pick_event', on_pick)
            '''))
    add(textwrap.dedent('''\
        # 6. Run the figure or export it without opening a window.
        # For permanent edits, change create_figure() above; no mplot options are needed.
        if __name__ == '__main__':
            import argparse
            import matplotlib

            parser = argparse.ArgumentParser(description=__doc__)
            parser.add_argument('--no-gui', action='store_true')
            parser.add_argument('--export', help='Output image: PDF, SVG, PNG, ...')
            args = parser.parse_args()
            if args.no_gui:
                matplotlib.use('Agg')

            import matplotlib.pyplot as plt

            fig, ax = create_figure()
            if args.export:
                fig.savefig(args.export, bbox_inches='tight')
            if not args.no_gui:
                plt.show()
        '''))
    return '\n'.join(lines)



def main(argv=None):
    opts,files,state=parse(sys.argv[1:] if argv is None else argv)
    if not files:
        if sys.stdin.isatty():raise PlotError('provide input files or pipe numeric data')
        files=[('-',state)]
    if sum(path=='-' for path,_ in files)>1:raise PlotError('stdin may be read only once')
    if opts['link'] and any(path=='-' for path,_ in files):
        raise PlotError('--link-data cannot reference stdin; use embedded mode')
    if opts['extent'] and opts['kind']!='image':raise PlotError('--extent is only for image')
    if not opts['gui']:
        import matplotlib
        matplotlib.use('Agg')
    inputs={Path(path).resolve() for path,_ in files if path!='-'}
    if opts.get('stack_values') and opts['stack_values'] != '-':
        inputs.add(Path(opts['stack_values']).resolve())
    for destination in (opts['save'],opts['export']):
        if destination and Path(destination).resolve() in inputs:
            raise PlotError('output must not overwrite an input file')
    series=prepare_series(opts,files)
    fig,ax=build_figure(opts,series)
    script=make_script(opts,files,series)
    if opts['save']:
        output=Path(opts['save']).absolute()
        if opts['link'] and any(output==Path(p).resolve() for p,_ in files):
            raise PlotError('project output must not overwrite a linked input')
        output.write_text(script,encoding='utf-8')
    else:
        with tempfile.NamedTemporaryFile(mode='w',prefix='mplot-',suffix='.py',delete=False,encoding='utf-8') as stream:
            stream.write(script);output=Path(stream.name)
    if opts['export']:fig.savefig(opts['export'],bbox_inches='tight')
    if opts['show']:print(script,end='')
    print(output)
    import matplotlib.pyplot as plt
    if opts['gui']:
        import matplotlib
        if 'agg' == matplotlib.get_backend().lower():
            raise PlotError(f'no interactive backend available; project saved in {output}; use --no-gui or configure a GUI backend')
        plt.show()
    plt.close(fig)
    return 0


if __name__=='__main__':
    try:
        sys.exit(main())
    except (PlotError,OSError,ValueError,EOFError,UnicodeError) as exc:
        print(f'mplot: {exc}',file=sys.stderr);sys.exit(2)
    except ImportError as exc:
        print(f'mplot: install NumPy and Matplotlib in this Python environment: {exc}',file=sys.stderr);sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
