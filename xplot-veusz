#!/usr/bin/env python3
"""Quick, editable Veusz plots with xplot-compatible options."""
import ast
import copy
import gzip
import json
import math
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

HELP = """Usage: xplot-veusz [options] [files ...]
Input: whitespace-separated numeric columns; blank lines separate data sets.
With no files, read standard input. Options may appear between files.

  -u1:2,1:3     1-based columns (default 1:2); -uall plots columns 2..N
  -u1:'cos($2)' expressions with $N, math functions, + - * / **
  -stxy|xydx|xydy|xydxdy   symmetric error-bar columns
  -xMIN:MAX -yMIN:MAX      axis limits
  -lx -ly                  logarithmic axes
  -tTEXT -xtTEXT -ytTEXT   title and axis labels
  -LTEXT                  legend label for subsequent files (enables legend)
  -wl|-wp|-wlp[:N]        lines, points, or both (default); optional symbol number
  -lwN -psN               line width and point size (default -ps2)
  -cSCHEME                default, solar, jamaica, rainbow, matplotlib,
                          or named/hex colors separated by colons
  -clist                  list available color names
  -l -d[N]                legend using filenames or N directory parts
  -kN                     shift each successive curve by N on y
  -m[WIDTH:HEIGHT]        page dimensions in pixels at 96 dpi
  -sFILE                  save editable .vsz file
  -show                   print generated Veusz commands
  --no-gui                generate .vsz without launching Veusz
  -h, --help              show this help

Examples:
  xplot-veusz data.dat
  xplot-veusz -u1:3 -x-1:1 data.* -u1:2 other.dat
  cat data.dat | xplot-veusz -uall -squick.vsz
"""

PALETTES = {
    'default': ['midnightblue', 'firebrick', 'gold'],
    'solar': ['black', 'crimson', 'gold'],
    'jamaica': ['dark green', 'yellow', 'red'],
    'rainbow': ['red', 'orange', 'yellow', 'green', 'cyan', 'blue', 'purple'],
    'matplotlib': ['Pcolor1', 'Pcolor2', 'Pcolor3', 'Pcolor4', 'Pcolor5',
                   'Pcolor6', 'Pcolor7', 'Pcolor8', 'Pcolor9'],
}
DEFAULT_SERIES_COLORS = (
    '#000000',  # black
    '#d62728',  # red
    '#1f77b4',  # blue
    '#2ca02c',  # green
    '#ff7f0e',  # orange
    '#9467bd',  # purple
    '#17becf',  # cyan
    '#e377c2',  # magenta
    '#8c564b',  # brown
    '#008080',  # teal
    '#808000',  # olive
    '#555555',  # dark grey
)
FUNCS = {name: getattr(math, name) for name in (
    'sin', 'cos', 'tan', 'asin', 'acos', 'atan', 'sinh', 'cosh', 'tanh',
    'exp', 'log', 'log10', 'sqrt', 'fabs', 'floor', 'ceil', 'atan2', 'hypot')}
FUNCS.update(abs=abs, min=min, max=max, pow=pow)
CONSTANTS = {'pi': math.pi, 'e': math.e}
MARKERS = ['circle', 'square', 'diamond', 'triangle', 'cross', 'plus',
           'star', 'pentagon', 'circle', 'square']
COLOR_FILE = Path(__file__).resolve().with_name('xplot-veusz-colors.json')


class PlotError(Exception):
    pass


def color_names():
    try:
        return json.loads(COLOR_FILE.read_text(encoding='utf-8'))
    except OSError as exc:
        raise PlotError(f'cannot load color table {COLOR_FILE}: {exc.strerror}') from exc


def expression(spec):
    if re.fullmatch(r'[1-9]\d*', spec):
        index = int(spec) - 1
        return lambda row: row[index]
    translated = re.sub(r'\$(\d+)', lambda m: f'col({int(m[1])})', spec)
    try:
        tree = ast.parse(translated, mode='eval')
    except SyntaxError as exc:
        raise PlotError(f'invalid column expression {spec!r}') from exc
    allowed = (ast.Expression, ast.BinOp, ast.UnaryOp, ast.Call, ast.Name,
               ast.Load, ast.Constant, ast.Add, ast.Sub, ast.Mult, ast.Div,
               ast.Pow, ast.Mod, ast.UAdd, ast.USub, ast.FloorDiv)
    for node in ast.walk(tree):
        if not isinstance(node, allowed):
            raise PlotError(f'unsupported operation in {spec!r}')
        if isinstance(node, ast.Name) and node.id not in set(FUNCS) | set(CONSTANTS) | {'col'}:
            raise PlotError(f'unknown function or name {node.id!r}')
        if isinstance(node, ast.Call) and (not isinstance(node.func, ast.Name)
                                           or node.func.id not in set(FUNCS) | {'col'}
                                           or node.keywords):
            raise PlotError(f'unsupported function call in {spec!r}')
        if isinstance(node, ast.Constant) and type(node.value) not in (int, float):
            raise PlotError(f'non-numeric constant in {spec!r}')
    code = compile(tree, '<column expression>', 'eval')
    def evaluate(row):
        def col(n):
            if type(n) is not int or n < 1:
                raise ValueError('column numbers must be positive integers')
            return row[n - 1]
        return float(eval(code, {'__builtins__': {}}, {**FUNCS, **CONSTANTS, 'col': col}))
    return evaluate


def numeric_pair(text, option):
    try:
        lo, hi = (float(s) for s in text.split(':'))
    except (ValueError, TypeError):
        raise PlotError(f'{option} requires MIN:MAX') from None
    if not math.isfinite(lo) or not math.isfinite(hi) or lo >= hi:
        raise PlotError(f'{option} requires finite MIN < MAX')
    return lo, hi


def initial_state():
    return dict(using=['1:2'], all=False, stype='xy', style='lp', symbol=None,
                linewidth=2.0, pointsize=2.0, shift=None, legend_label=None)


def parse(argv):
    state = initial_state()
    opts = dict(x=None, y=None, lx=False, ly=False, title='', xt='', yt='',
                legend=None, dirs=None, size=(1024, 768), save=None, show=False,
                gui=True, palette=None)
    files = []
    for arg in argv:
        if arg in ('-h', '--help'):
            print(HELP)
            raise SystemExit(0)
        if arg == '-clist':
            colors = color_names()
            print('\n'.join(sorted(colors)))
            raise SystemExit(0)
        if arg == '--no-gui':
            opts['gui'] = False
        elif arg == '-show':
            opts['show'] = True
        elif arg.startswith('-L'):
            if not arg[2:]:
                raise PlotError('-L needs a legend label')
            state['legend_label'] = arg[2:]
            opts['legend'] = 'file'
        elif arg in ('-lx', '-ly'):
            opts[arg[1:]] = True
        elif arg == '-l':
            opts['legend'] = 'file'
        elif arg.startswith('-d'):
            suffix = arg[2:]
            if suffix and not suffix.isdigit():
                raise PlotError('-d accepts an optional positive integer')
            opts['legend'] = 'directory'
            opts['dirs'] = int(suffix) if suffix else None
        elif arg.startswith('-st'):
            value = arg[3:]
            if value not in ('xy', 'xydx', 'xydy', 'xydxdy'):
                raise PlotError('-st must be xy, xydx, xydy or xydxdy')
            state['stype'] = value
            state['using'] = None
            state['all'] = False
        elif arg.startswith('-lw') or arg.startswith('-ps'):
            key = 'linewidth' if arg.startswith('-lw') else 'pointsize'
            try:
                state[key] = float(arg[3:])
            except ValueError:
                raise PlotError(f'{arg[:3]} needs a number') from None
            if not math.isfinite(state[key]) or state[key] < 0:
                raise PlotError(f'{arg[:3]} needs a nonnegative finite number')
        elif arg.startswith('-xt') or arg.startswith('-yt'):
            opts[arg[1:3]] = arg[3:]
        elif arg.startswith('-x') or arg.startswith('-y'):
            opts[arg[1]] = numeric_pair(arg[2:], arg[:2])
        elif arg.startswith('-t'):
            opts['title'] = arg[2:]
        elif arg.startswith('-u'):
            value = arg[2:]
            state['all'] = value == 'all'
            if value in ('one', '1'):
                state['using'] = None
            elif value == 'all':
                state['using'] = None
            else:
                state['using'] = value.split(',')
                if not all(state['using']):
                    raise PlotError('-u needs nonempty column specifications')
        elif arg.startswith('-w'):
            m = re.fullmatch(r'(l|p|lp)(?::(\d+))?', arg[2:])
            if not m:
                raise PlotError('-w must be l, p, or lp, optionally :N')
            state['style'] = m[1]
            state['symbol'] = int(m[2]) if m[2] else None
        elif arg.startswith('-k'):
            try:
                state['shift'] = float(arg[2:])
            except ValueError:
                raise PlotError('-k needs a numeric shift') from None
            if not math.isfinite(state['shift']):
                raise PlotError('-k needs a finite shift')
        elif arg.startswith('-c'):
            opts['palette'] = arg[2:] or 'default'
        elif arg.startswith('-m'):
            value = arg[2:]
            if value:
                opts['size'] = page_size(value)
            else:
                opts['size'] = (1024, 768)
        elif arg.startswith('-s'):
            value = arg[2:]
            if not value:
                raise PlotError('-s needs a filename')
            opts['save'] = str(Path(value).with_suffix('.vsz'))
        elif arg == '-':
            files.append((arg, copy.deepcopy(state)))
        elif arg.startswith('-') and not Path(arg).is_file():
            raise PlotError(f'unknown option {arg!r}')
        else:
            files.append((arg, copy.deepcopy(state)))
    return opts, files, state


def page_size(value):
    try:
        w, h = (int(v) for v in value.split(':'))
    except ValueError:
        raise PlotError('-m needs WIDTH:HEIGHT in pixels') from None
    if w <= 0 or h <= 0:
        raise PlotError('-m dimensions must be positive')
    return w, h


def read_blocks(path):
    if path == '-':
        stream = sys.stdin
        close = False
    elif path.endswith('.gz'):
        stream = gzip.open(path, 'rt', encoding='utf-8')
        close = True
    else:
        stream = open(path, encoding='utf-8')
        close = True
    blocks, block = [], []
    try:
        for line_no, line in enumerate(stream, 1):
            stripped = line.strip()
            if not stripped or stripped == '&':
                if block:
                    blocks.append(block)
                    block = []
                continue
            if stripped.startswith('#') or stripped.startswith('@'):
                continue
            try:
                row = [float(v.replace('D', 'E').replace('d', 'e')) for v in stripped.split()]
            except ValueError:
                raise PlotError(f'{path}:{line_no}: expected numeric columns') from None
            block.append(row)
        if block:
            blocks.append(block)
    finally:
        if close:
            stream.close()
    return blocks


def specs_for(state, block):
    if state['all']:
        return [f'1:{i}' for i in range(2, len(block[0]) + 1)]
    if state['using'] is not None:
        return state['using']
    n = 4 if state['stype'] == 'xydxdy' else 3 if state['stype'] != 'xy' else 2
    return [':'.join(map(str, range(1, n + 1)))]


def prepare_series(files):
    series = []
    for path, state in files:
        try:
            blocks = read_blocks(path)
        except OSError as exc:
            raise PlotError(f'cannot read {path}: {exc.strerror}') from exc
        for block_no, block in enumerate(blocks, 1):
            for spec in specs_for(state, block):
                parts = spec.split(':')
                expected = 4 if state['stype'] == 'xydxdy' else 3 if state['stype'] != 'xy' else 2
                if len(parts) != expected:
                    raise PlotError(f'{path}: {state["stype"]} requires {expected} columns in {spec!r}')
                funcs = [expression(p) for p in parts]
                columns = [[] for _ in funcs]
                for row_no, row in enumerate(block, 1):
                    try:
                        values = [float(fn(row)) for fn in funcs]
                    except (IndexError, ValueError, OverflowError, ZeroDivisionError) as exc:
                        raise PlotError(f'{path}, block {block_no}, row {row_no}: {exc}') from exc
                    for dest, value in zip(columns, values):
                        dest.append(value)
                shift = state['shift'] or 0.0
                if shift:
                    columns[1] = [v + shift * len(series) for v in columns[1]]
                series.append(dict(path=path, block=block_no, blocks=len(blocks),
                                   spec=spec, state=state, cols=columns))
    if not series:
        raise PlotError('no numeric data to plot')
    return series


def palette_colors(value, n):
    if value is None:
        return [DEFAULT_SERIES_COLORS[i % len(DEFAULT_SERIES_COLORS)] for i in range(n)]
    colors = color_names()
    stops = PALETTES.get(value, value.split(':'))
    rgb = []
    for stop in stops:
        color = stop if re.fullmatch(r'#[0-9a-fA-F]{6}', stop) else colors.get(stop)
        if color is None:
            raise PlotError(f'unknown color {stop!r}; use -clist')
        rgb.append(tuple(bytes.fromhex(color[1:])))
    if len(rgb) == 1:
        rgb *= 2
    output = []
    for i in range(n):
        t = 0 if n == 1 else i * (len(rgb) - 1) / (n - 1)
        j = min(int(t), len(rgb) - 2)
        fraction = t - j
        color = tuple(round(a + fraction * (b - a)) for a, b in zip(rgb[j], rgb[j + 1]))
        output.append('#%02x%02x%02x' % color)
    return output


def command(operation, *args, **kwargs):
    params = [repr(v) for v in args] + [f'{k}={v!r}' for k, v in kwargs.items()]
    return f'{operation}({", ".join(params)})'


def veusz_text(value):
    """Veusz uses TeX-like commands directly, without math-mode dollars."""
    return re.sub(r'(?<!\\)\$([^$]+)\$', lambda match: match.group(1), value)


def make_document(opts, series):
    lines = ['# Editable Veusz document generated by xplot-veusz']
    def add(operation, *args, **kwargs):
        lines.append(command(operation, *args, **kwargs))
    colors = palette_colors(opts['palette'], len(series))
    for i, item in enumerate(series, 1):
        x, y, *errors = item['cols']
        xerr = yerr = None
        stype = item['state']['stype']
        if stype == 'xydx':
            xerr = errors[0]
        elif stype == 'xydy':
            yerr = errors[0]
        elif stype == 'xydxdy':
            xerr, yerr = errors
        add('SetData', f'x{i}', x, symerr=xerr)
        add('SetData', f'y{i}', y, symerr=yerr)
    add('Add', 'page', name='page1', autoadd=False)
    add('To', 'page1')
    if opts['size']:
        w, h = opts['size']
        add('Set', 'width', f'{w / 96 * 2.54:.4f}cm')
        add('Set', 'height', f'{h / 96 * 2.54:.4f}cm')
    add('Add', 'graph', name='graph1', autoadd=False)
    add('To', 'graph1')
    add('Set', 'leftMargin', '2.2cm')
    add('Set', 'rightMargin', '0.8cm')
    add('Set', 'topMargin', '1.2cm')
    add('Set', 'bottomMargin', '1.8cm')
    for axis in ('x', 'y'):
        add('Add', 'axis', name=axis, autoadd=False)
        add('To', axis)
        if axis == 'y':
            add('Set', 'direction', 'vertical')
        if opts[f'{axis}t']:
            add('Set', 'label', veusz_text(opts[f'{axis}t']))
        if opts[axis]:
            lo, hi = opts[axis]
            if opts[f'l{axis}'] and lo <= 0:
                raise PlotError(f'-l{axis} requires a positive axis minimum')
            add('Set', 'min', lo)
            add('Set', 'max', hi)
        if opts[f'l{axis}']:
            add('Set', 'log', True)
        add('To', '..')
    if opts['title']:
        add('Add', 'label', name='title1', autoadd=False)
        add('To', 'title1')
        add('Set', 'label', veusz_text(opts['title']))
        add('Set', 'xPos', [0.5])
        add('Set', 'yPos', [0.97])
        add('To', '..')
    for i, item in enumerate(series, 1):
        state = item['state']
        add('Add', 'xy', name=f'curve{i}', autoadd=False)
        add('To', f'curve{i}')
        add('Set', 'xData', f'x{i}')
        add('Set', 'yData', f'y{i}')
        if opts['legend']:
            path = Path(item['path'])
            if state['legend_label'] is not None:
                label = state['legend_label']
            elif opts['legend'] == 'file':
                label = path.name if item['path'] != '-' else 'stdin'
            else:
                parts = path.parent.parts
                label = '/'.join(parts[-opts['dirs']:] if opts['dirs'] else parts) or '.'
            if item['blocks'] > 1:
                label += f' set {item["block"]}'
            if item['spec'] != '1:2':
                label += f' {item["spec"]}'
            add('Set', 'key', veusz_text(label))
        add('Set', 'PlotLine/hide', state['style'] == 'p')
        marker_index = state['symbol'] if state['symbol'] is not None else i - 1
        add('Set', 'marker', 'none' if state['style'] == 'l' else MARKERS[marker_index % len(MARKERS)])
        if state['style'] != 'l' and len(item['cols'][0]) > 30:
            add('Set', 'thinfactor', math.ceil(len(item['cols'][0]) / 30))
        add('Set', 'PlotLine/width', f'{state["linewidth"]:g}pt')
        add('Set', 'markerSize', f'{state["pointsize"] * 3:g}pt')
        if colors[i - 1]:
            add('Set', 'PlotLine/color', colors[i - 1])
            add('Set', 'MarkerLine/color', colors[i - 1])
            add('Set', 'MarkerFill/color', colors[i - 1])
        add('To', '..')
    if opts['legend']:
        add('Add', 'key', name='key1', autoadd=False)
        add('To', 'key1')
        add('Set', 'vertPosn', 'top')
        add('Set', 'Border/hide', True)
        add('To', '..')
    add('To', '..')
    add('To', '..')
    return '\n'.join(lines) + '\n'


def launch(path):
    if sys.platform == 'darwin':
        app = Path('/Applications/Veusz.app')
        if app.exists():
            # Launch Services sends FileOpen to the running Veusz process.
            result = subprocess.run(['/usr/bin/open', '-a', str(app), str(path)],
                                    capture_output=True, text=True)
            if result.returncode:
                raise PlotError(f'cannot open Veusz: {result.stderr.strip()}; '
                                f'document saved at {path}')
            return
    executable = shutil.which('veusz')
    if executable:
        subprocess.Popen([executable, str(path)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    raise PlotError(f'Veusz executable not found; document saved at {path}')


def main(argv):
    opts, files, final_state = parse(argv)
    if not files:
        if sys.stdin.isatty():
            raise PlotError('provide data files or pipe numeric data on stdin')
        files = [('-', copy.deepcopy(final_state))]
    elif not sys.stdin.isatty():
        # A pipe alongside file arguments follows the original xplot behavior.
        # Ignore an empty inherited stdin (common in automation).
        if not sys.stdin.closed and sys.stdin.buffer.peek(1):
            files.append(('-', copy.deepcopy(files[-1][1])))
    series = prepare_series(files)
    document = make_document(opts, series)
    if opts['save']:
        path = Path(opts['save']).expanduser().absolute()
        try:
            path.write_text(document, encoding='utf-8')
        except OSError as exc:
            raise PlotError(f'cannot save {path}: {exc.strerror}') from exc
    else:
        fd, name = tempfile.mkstemp(prefix='xplot-veusz-', suffix='.vsz')
        with os.fdopen(fd, 'w', encoding='utf-8') as out:
            out.write(document)
        path = Path(name)
    if opts['show']:
        print(document, end='')
    if not opts['gui']:
        print(path, file=sys.stderr if opts['show'] else sys.stdout)
        return
    try:
        launch(path)
    except OSError as exc:
        raise PlotError(f'cannot launch Veusz: {exc.strerror}; document saved at {path}') from exc
    if opts['save']:
        print(path)


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except PlotError as exc:
        print(f'xplot-veusz: {exc}', file=sys.stderr)
        raise SystemExit(2) from None
