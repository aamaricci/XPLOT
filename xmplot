def grace_string(value):
    # Grace interprets backslashes as text formatting; preserve them.
    if '\n' in value or '\r' in value or '\x00' in value:
        raise PlotError('labels must not contain newlines or NUL characters')
    return '"' + value.replace('"', '\\"') + '"'


def make_document(opts, series):
    lines = ['# Grace project file generated by xmplot']
    lines += ['@' + line for line in GRACE_TEMPLATE.splitlines()
              if line.strip() and not line.lstrip().startswith('#')]
    def add(text):
        lines.append('@' + text)
    w, h = opts['size']
    add(f'page size {w}, {h}')
    add('with g0')
    add('view 0.15, 0.12, 0.85, 0.88')
    add('subtitle ' + grace_string(opts['title']))
    add('xaxis label ' + grace_string(opts['xt']))
    add('yaxis label ' + grace_string(opts['yt']))
    add('legend ' + ('on' if opts['legend'] else 'off'))
    colors = palette_colors(opts['palette'], len(series)) if opts['palette'] else None
    for i, item in enumerate(series):
        state = item['state']
        if colors:
            rgb = tuple(bytes.fromhex(colors[i][1:]))
            color = i + 17
            add(f'map color {color} to ({rgb[0]}, {rgb[1]}, {rgb[2]}), "xmplot{color}"')
        else:
            color = 1 + i % 16
        symbol = state['symbol'] if state['symbol'] is not None else 1 + i % 9
        if not 0 <= symbol <= 10:
            raise PlotError('symbol number must be between 0 and 10')
        add(f's{i} line type {0 if state["style"] == "p" else 1}')
        add(f's{i} symbol {0 if state["style"] == "l" else symbol}')
        add(f's{i} line color {color}')
        add(f's{i} symbol color {color}')
        add(f's{i} linewidth {state["linewidth"]}')
        add(f's{i} symbol size {state["pointsize"]}')
        if opts['legend']:
            label = state['legend_label']
            if label is None:
                path = Path(item['path'])
                label = str(path.parent) if opts['legend'] == 'directory' else path.name
                if opts['legend'] == 'directory' and opts['dirs']:
                    label = str(Path(*path.parent.parts[:opts['dirs']]))
                if item['blocks'] > 1:
                    label += f' set {item["block"]}'
                label += ' ' + item['spec']
            add(f's{i} legend ' + grace_string(label))
        add(f'target G0.S{i}')
        add('type ' + state['stype'])
        for row in zip(*item['cols']):
            lines.append(' '.join(format(v, '.17g') for v in row))
        lines.append('&')
    for axis in ('x', 'y'):
        index = 0 if axis == 'x' else 1
        if opts['l' + axis]:
            if any(v <= 0 for item in series for v in item['cols'][index]):
                raise PlotError(f'logarithmic {axis} axis requires positive coordinates')
            if opts[axis] and opts[axis][0] <= 0:
                raise PlotError(f'logarithmic {axis} limits must be positive')
            add(f'{axis}axes scale logarithmic')
    add('autoscale')
    for axis in ('x', 'y'):
        if opts[axis]:
            lo, hi = opts[axis]
            add(f'world {axis}min {lo:.17g}')
            add(f'world {axis}max {hi:.17g}')
    add('autoticks')
    return '\n'.join(lines) + '\n'


def main(argv=None):
    opts, files, state = parse(sys.argv[1:] if argv is None else argv)
    if not files:
        if sys.stdin.isatty():
            raise PlotError('no input files; provide a file or pipe numeric data')
        files = [('-', state)]
    if sum(path == '-' for path, _ in files) > 1:
        raise PlotError('standard input may be used only once')
    series = prepare_series(files)
    document = make_document(opts, series)
    if opts['save']:
        output = Path(opts['save']).absolute()
        output.write_text(document, encoding='utf-8')
    else:
        with tempfile.NamedTemporaryFile(mode='w', suffix='.agr', prefix='xmplot-',
                                         encoding='utf-8', delete=False) as stream:
            stream.write(document)
            output = Path(stream.name)
    if opts['show']:
        print(document, end='')
    if not opts['gui']:
        print(output)
        return 0
    command = ['/Applications/qtgrace.app/Contents/MacOS/qtgrace', '-free', str(output)]
    try:
        result = subprocess.run(command, check=False)
    except FileNotFoundError:
        raise PlotError(f'qtgrace not found in PATH; plot saved in {output}') from None
    if result.returncode:
        print(f'xmplot: qtgrace failed ({result.returncode}); plot saved in {output}', file=sys.stderr)
    return result.returncode if result.returncode >= 0 else 128 - result.returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (PlotError, OSError, EOFError, UnicodeError) as exc:
        print(f'xmplot: {exc}', file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
